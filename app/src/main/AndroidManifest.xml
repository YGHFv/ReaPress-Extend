<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      miuix-blur 把 minSdk 声明成 33（RuntimeShader 需要 Android 13）。库内所有效果路径都有
      isRuntimeShaderSupported()（SDK_INT >= 33）运行时门禁，低版本设备只是没有效果、不会崩；
      模块自己的调用侧同样先查这个开关再挂玻璃层，所以放行合并。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 模块常驻后台接收 system_server 投来的拦截事件，靠前台服务保活。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      定位有两个用处，精度要求差一个量级，所以两份都申请：
      - **粗略**（COARSE）：身份码弹窗判「离我最近的那个驿站」—— 需要的精度是「哪个驿站」，
        也就是几百米到几公里，粗略定位绰绰有余；
      - **精确**（FINE）：「驿站管理」里点「获取」时把这一站门口的坐标记下来（StationFingerprint）。
        粗定位在楼群里能差一两公里，相邻两个驿站就分不开了，那一项等于白记。
      边界：粗略那份**用完即弃**（只在这一屏里参与一次比较，不入库、不上传）；精确那份只落在
      本机驿站规则里（用户自己点「获取」才产生，且「恢复默认」能一键清掉）。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      「附近 WiFi」：`ACCESS_WIFI_STATE` 是普通权限（读 WiFi 状态）；Android 13 起读扫描结果
      还要 `NEARBY_WIFI_DEVICES`。
      ⚠️ **不加 `usesPermissionFlags="neverForLocation"`**：那个 flag 声明「本应用不用 WiFi
      结果推断位置」，系统会据此过滤掉一部分扫描结果 —— 而我们的用途恰恰就是拿 WiFi 判
      「人在不在驿站门口」。声明要跟实际行为一致，不能为了少要一份授权就把它写上。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!--
      轨迹拉取请求的发送凭证：菜鸟进程里的 receiver 只收**持有这个权限**的广播方
      （signature 级 = 只有模块自己签得出），否则设备上任何 app 都能拿用户的菜鸟登录态
      替自己查任意单号。声明与使用在同一 APK，签名必然匹配，安装即授予。
    -->
    <permission
        android:name="io.github.YGHFv.ReaPressExtend.permission.TRACE_REQUEST"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.YGHFv.ReaPressExtend.permission.TRACE_REQUEST" />

    <queries>
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.taobao.taobao" />
    </queries>

    <application
        android:name=".ExpressApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:theme="@style/AppTheme">

        <!--
          LSPosed Manager 的模块识别靠这四个 meta-data。API 102 实际生效的模块元数据在
          META-INF/xposed/module.prop（minApiVersion / targetApiVersion / staticScope），
          这里这份是给 Manager 界面显示用的，两者必须一致。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:resource="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 模块自己的主界面。也是让模块脱离 stopped 状态的入口 —— stopped 应用的广播收不到，
             而拦截事件的投递正是靠广播。 -->
        <activity
            android:name=".ui.ExpressMainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/ModuleTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          接收 system_server 投来的拦截事件。exported=true 是必需的：投递方是 system_server
          （system uid），不是本应用。安全性由「显式组件 + 私有 action」保证 —— 别的应用虽然
          也能发这个广播，但最多只能让模块多发一条快递通知，不涉及任何敏感数据读取。

          没有 intent-filter：投递方用 setClassName 显式寻址（见 ExpressRelaySender）。
          隐式广播在 Android 8+ 受限，且我们本来就知道目标是谁。
        -->
        <receiver
            android:name=".relay.ExpressRelayReceiver"
            android:enabled="true"
            android:exported="true" />
    </application>
</manifest>
