<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      miuix-blur 把 minSdk 声明成 33（RuntimeShader 需要 Android 13）。库内所有效果路径都有
      isRuntimeShaderSupported()（SDK_INT >= 33）运行时门禁，低版本设备只是没有效果、不会崩；
      模块自己的调用侧同样先查这个开关再挂玻璃层，所以放行合并。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 模块常驻后台接收 system_server 投来的拦截事件，靠前台服务保活。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      自动轮查用 specialUse 而不是 dataSync：Android 15 起 dataSync 类前台服务被限制
      每 24 小时最多跑 6 小时，而轮查的语义是「一直开着」（用户自己开的秒表）。
      specialUse 没有时长上限，代价是必须声明下面那条 property 说明用途。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
      定位有两个用处，精度要求差一个量级，所以两份都申请：
      - **粗略**（COARSE）：身份码弹窗判「离我最近的那个驿站」—— 需要的精度是「哪个驿站」，
        也就是几百米到几公里，粗略定位绰绰有余；
      - **精确**（FINE）：「驿站管理」里点「获取」时把这一站门口的坐标记下来（StationFingerprint）。
        粗定位在楼群里能差一两公里，相邻两个驿站就分不开了，那一项等于白记。
      边界：粗略那份**用完即弃**（只在这一屏里参与一次比较，不入库、不上传）；精确那份只落在
      本机驿站规则里（用户自己点「获取」才产生，且「恢复默认」能一键清掉）。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      「附近 WiFi」：`ACCESS_WIFI_STATE` 是普通权限（读 WiFi 状态）；Android 13 起读扫描结果
      还要 `NEARBY_WIFI_DEVICES`。
      ⚠️ **不加 `usesPermissionFlags="neverForLocation"`**：那个 flag 声明「本应用不用 WiFi
      结果推断位置」，系统会据此过滤掉一部分扫描结果 —— 而我们的用途恰恰就是拿 WiFi 判
      「人在不在驿站门口」。声明要跟实际行为一致，不能为了少要一份授权就把它写上。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!--
      轨迹拉取请求的发送凭证：菜鸟进程里的 receiver 只收**持有这个权限**的广播方
      （signature 级 = 只有模块自己签得出），否则设备上任何 app 都能拿用户的菜鸟登录态
      替自己查任意单号。声明与使用在同一 APK，签名必然匹配，安装即授予。
    -->
    <permission
        android:name="io.github.YGHFv.ReaPressExtend.permission.TRACE_REQUEST"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.github.YGHFv.ReaPressExtend.permission.TRACE_REQUEST" />

    <!--
      包可见性（Android 11+）。点名的三个是模块主要的来源 App；最后那条**通用 LAUNCHER 查询**
      是给「打开原通知」用的：记录里的来源还可能是别的应用（例如系统短信），而
      `getLaunchIntentForPackage` 在没声明可见性时一律返回 null —— 少了它，那些记录
      就只能退回「按快照重建」，正是会卡在宿主启动页的那条路。
    -->
    <queries>
        <package android:name="com.cainiao.wireless" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.taobao.taobao" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ExpressApplication"
        android:allowBackup="false"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:theme="@style/AppTheme">

        <!--
          LSPosed Manager 的模块识别靠这四个 meta-data。API 102 实际生效的模块元数据在
          META-INF/xposed/module.prop（minApiVersion / targetApiVersion / staticScope），
          这里这份是给 Manager 界面显示用的，两者必须一致。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:resource="@string/module_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 模块自己的主界面。也是让模块脱离 stopped 状态的入口 —— stopped 应用的广播收不到，
             而拦截事件的投递正是靠广播。 -->
        <activity
            android:name=".ui.ExpressMainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:theme="@style/ModuleTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          接收 system_server 投来的拦截事件。exported=true 是必需的：投递方是 system_server
          （system uid），不是本应用。接收端必须先校验框架分发的安装级随机凭据，再读取业务载荷；
          显式组件与 action 名称本身不是身份认证。凭据不进入备份，未经认证的消息一律丢弃。

          没有 intent-filter：投递方用 setClassName 显式寻址（见 ExpressRelaySender）。
          隐式广播在 Android 8+ 受限，且我们本来就知道目标是谁。
        -->
        <receiver
            android:name=".relay.ExpressRelayReceiver"
            android:enabled="true"
            android:exported="true" />

        <!--
          自动轮查：后台按 3 分钟±1 分钟一件、一轮 30 分钟的节奏拉在途件轨迹（默认关闭）。
          为什么必须是前台服务而不是 WorkManager / 闹钟，见 AutoWatchService 的类注释。

          exported=false：只有本应用（界面开关、开机广播）能起它。前台服务的通知栏那一行
          就是这个服务在跑的全部痕迹，别再加别的入口。
        -->
        <service
            android:name=".relay.AutoWatchService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="按用户设定的时间与频率查询其本人已授权的快递物流轨迹" />
        </service>

        <!--
          开机把自动轮查接回去（用户开了它却不进模块时，这条是唯一的重启路径）。
        -->
        <receiver
            android:name=".relay.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          定时备份的闹钟（BackupScheduler.ensureScheduled 排下）。

          exported=false + 无 intent-filter：这是给自己发的闹钟投递用的，别的应用既不需要
          也不应该能触发它。用广播接收器而不是 WorkManager：这件事一秒内就做完，也没有
          「必须做完」的语义（下一次到点、或用户打开模块时都会补），不值得引入一套调度框架。

          闹钟用的是**不精确**的那种（setInexactRepeating）：备份晚半小时没有任何后果，
          而精确闹钟要 SCHEDULE_EXACT_ALARM，还有被系统回收的风险。
        -->
        <receiver
            android:name=".backup.BackupAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
          免 root 方案的通知来源：用户授予「通知使用权」后由系统绑定，模块进程内读宿主通知原文。

          exported=true + 那条 intent-filter 是系统要求的写法（绑定方是 system_server）；
          安全性由 android:permission 保证 —— 只有持有 BIND_NOTIFICATION_LISTENER_SERVICE
          （signature 级，只有系统签得出）的一方绑得上，别的应用既绑不了也调不动它。

          它与 Xposed 的 hook 是两条独立的腿：hook 在投递前拦，这里在出现后读；两条都在时
          靠 ExpressDeliveryLedger 去重（见那个类的注释）。没有 LSPosed 也能用这一条。
        -->
        <service
            android:name=".noroot.ExpressNotificationListener"
            android:enabled="true"
            android:exported="true"
            android:label="@string/module_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
